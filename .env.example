# PostgreSQL: use a pooled, SSL-enabled URL from your provider in production.
DATABASE_URL=

# The only administrator credentials. No default account is shipped.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Server-side Cloudinary credentials, required for direct image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: import a small illustrative catalogue only on an empty database.
SEED_SAMPLE_DATA=false
SUPPORT_EMAIL=
